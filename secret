#!/bin/sh
set -eu

program="$0"

AGE=${AGE:-age}
OATHTOOL=${OATHTOOL:-oathtool}

SECRET_DIR=${SECRET_DIR:-~/.secrets}

error()
{
	echo "$1"
	exit 1
}

usage()
{
	u=$({
		echo "Usage: $program"
		echo "       $program -g entry [field]"
		echo "       $program -n entry"
		echo "       $program -s entry"
	})

	error "$u"
}
